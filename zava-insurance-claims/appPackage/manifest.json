{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.25/MicrosoftTeams.schema.json",
    "manifestVersion": "1.25",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "My App, Inc.",
        "websiteUrl": "https://www.example.com",
        "privacyUrl": "https://www.example.com/privacy",
        "termsOfUseUrl": "https://www.example.com/termofuse"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "Zava Insurance Claims${{APP_NAME_SUFFIX}}",
        "full": "Zava Insurance Claims Agent"
    },
    "description": {
        "short": "Manage Zava Insurance claims, inspections, and contractors",
        "full": "A M365 Copilot agent for managing Zava Insurance claims. View dashboards, inspect claim details, manage inspections and purchase orders, assign contractors, and update claim statuses — all powered by the Zava Insurance MCP server and grounded in SharePoint claims documentation."
    },
    "accentColor": "#FFFFFF",
    "supportsChannelFeatures": "tier1",
    "composeExtensions": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "copilotAgents": {
        "declarativeAgents": [            
            {
                "id": "declarativeAgent",
                "file": "declarativeAgent.json"
            }
        ]
    },
    "validDomains": []
}